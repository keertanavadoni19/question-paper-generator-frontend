# Copy to backend/.env and fill in. Never commit backend/.env.
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Long random secret for login tokens (at least 32 characters), e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Supabase projects: Project Settings → API → Project URL and the service_role key.
# Service keys bypass Row Level Security, so they must stay on this server.
SUPABASE_DB1_URL=        # Chemistry · Class 11
SUPABASE_DB1_SERVICE_KEY=
SUPABASE_DB2_URL=        # Chemistry · Class 12
SUPABASE_DB2_SERVICE_KEY=
SUPABASE_DB3_URL=        # Mathematics · Class 11
SUPABASE_DB3_SERVICE_KEY=
SUPABASE_DB4_URL=        # Mathematics · Class 12
SUPABASE_DB4_SERVICE_KEY=
SUPABASE_DB5_URL=        # Biology · Class 12
SUPABASE_DB5_SERVICE_KEY=
SUPABASE_DB6_URL=        # Biology · Class 11
SUPABASE_DB6_SERVICE_KEY=
SUPABASE_DB7_URL=        # Physics · Class 11 + users, papers, settings, question_usage
SUPABASE_DB7_SERVICE_KEY=
SUPABASE_DB8_URL=        # Physics · Class 12
SUPABASE_DB8_SERVICE_KEY=

# Project that holds users / papers / settings / question_usage
MAIN_DB=7
# Let people create teacher accounts from the Sign-up page
ALLOW_SIGNUP=false
# Show "(Legacy / Removed Syllabus)" and "General" chapters
INCLUDE_LEGACY_CHAPTERS=false
# Hide chapters with fewer questions than this
MIN_CHAPTER_QUESTIONS=5
# How often to re-read the question bank (minutes)
INDEX_REFRESH_MINUTES=30
